{
    "openapi": "3.0.0",
    "info": {
      "title": "SDFEngine Learning API",
      "version": "1.0.0",
      "description": "API REST de práctica para el proyecto de aprendizaje SDFEngine"
    },
    "paths": {
      "/api/orders": {
        "post": {
          "summary": "Crear un order con items",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "customerId",
                    "items"
                  ],
                  "properties": {
                    "customerId": {
                      "type": "integer",
                      "example": 1
                    },
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "productId",
                          "quantity",
                          "unitPrice"
                        ],
                        "properties": {
                          "productId": {
                            "type": "integer",
                            "example": 1
                          },
                          "quantity": {
                            "type": "integer",
                            "example": 2
                          },
                          "unitPrice": {
                            "type": "number",
                            "example": 10.5
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "201": {
              "description": "Order creado correctamente",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "success": {
                        "type": "boolean",
                        "example": true
                      },
                      "data": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "customerId": {
                            "type": "integer"
                          },
                          "totalAmount": {
                            "type": "number"
                          },
                          "status": {
                            "type": "string",
                            "example": "pending"
                          },
                          "items": {
                            "type": "array"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "400": {
              "description": "Datos inválidos"
            },
            "500": {
              "description": "Error interno del servidor"
            }
          }
        }
      },
      "/api/orders/{id}": {
        "get": {
          "summary": "Obtener un order por ID",
          "parameters": [
            {
              "name": "id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer"
              },
              "example": 1
            }
          ],
          "responses": {
            "200": {
              "description": "Order encontrado"
            },
            "404": {
              "description": "Order no encontrado"
            }
          }
        }
      }
    }
  }